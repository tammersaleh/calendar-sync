# OS
.DS_Store

# CLAUDE.local.md anywhere (personal, never shared)
CLAUDE.local.md

# Claude Code: ignore all local state under .claude/, then allow-list the
# shared bits. Must be .claude/* not .claude/ - git can't re-include a
# child of an excluded directory.
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/

# Local state and crit artifacts (per-machine)
state.json
state.json.lock
.crit/

# Local mise config (per-machine env vars, e.g. E2E test calendar IDs)
.mise.local.toml
mise.local.toml
